DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=sistema_chepola
DB_PORT=3306
PORT=3000

# Nombre del negocio que aparece en el encabezado del ticket de impresión (opcional)
TICKET_NEGOCIO_NOMBRE=Chapola

# Secreto para firmar los tokens de login. Generar uno propio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar_con_un_secreto_aleatorio

# --- Facturación electrónica ARCA (ex AFIP) ---
# Pasar de "mi CUIT en homologación" a "CUIT del cliente en producción" es exclusivamente
# cambiar estas variables (ver Fase 0 del plan) — no requiere ningún cambio de código.
AFIP_ENTORNO=homologacion
AFIP_CUIT=
AFIP_PUNTO_VENTA=1
# monotributista | responsable_inscripto — determina qué tipos de comprobante se ofrecen
AFIP_CONDICION_IVA_EMISOR=monotributista
AFIP_CERT_PATH=./certs/homologacion/cert.pem
AFIP_KEY_PATH=./certs/homologacion/private_key.key
# Alícuota general usada para Factura A/B (Id de ARCA: 5 = 21%). No aplica a Factura C.
AFIP_IVA_ALICUOTA_ID=5
AFIP_IVA_ALICUOTA_PORCENTAJE=21
AFIP_RAZON_SOCIAL=
AFIP_DOMICILIO_COMERCIAL=
AFIP_INICIO_ACTIVIDADES=
# Número de Ingresos Brutos a imprimir en la factura (o "Exento" si corresponde)
AFIP_INGRESOS_BRUTOS=
